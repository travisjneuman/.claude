  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='session-start-pull.sh';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
            "async": true
          },
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='session-start-repo-health.sh';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
            "statusMessage": "Checking repo health"
          },
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='local-session-start.sh';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|EnterWorktree|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='guard.js';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='secret-scan.js';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='session-end-repo-health.sh';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.env.HOOK_NAME='daily-maintenance.js';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 15000,
  "statusLine": {
    "type": "command",
    "command": "node -e \"process.env.HOOK_NAME='statusline.js';require(require('path').join(require('os').homedir(),'.claude','hooks','run-hook'))\"",
    "padding": 0
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "claude-security@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "brag@brag": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "gsd-core": {
      "source": {
        "source": "github",
        "repo": "open-gsd/gsd-core"
      }
    },
    "brag": {
      "source": {
        "source": "github",
        "repo": "latent-spaces/brag"
      }
    }
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": false,
  "autoCompactWindow": 300000,
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "claudeMdExcludes": [
    "**/my.notes/*/**/AGENTS.md",
    "**/my.notes/*/**/CLAUDE.md",
    "**/Backups/**/AGENTS.md",
    "**/Backups/**/CLAUDE.md",
    "**/backups/**/AGENTS.md",
    "**/backups/**/CLAUDE.md",
    "**/Archive/**/AGENTS.md",
    "**/Archive/**/CLAUDE.md",
    "**/archive/**/AGENTS.md",
    "**/archive/**/CLAUDE.md",
    "**/exact-originals/**/AGENTS.md",
    "**/Exact Originals/**/AGENTS.md"
  ],
  "theme": "dark",
  "verbose": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true
}
