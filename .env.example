# ~/.claude/.env.local — Machine-specific configuration
# Copy this file to .env.local and customize for your machine.
# .env.local is gitignored and will not be committed.
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your settings

# =============================================================================
# Custom project directories to pull
# =============================================================================
# The pull script (_pull-all-repos.sh) recursively scans these for git repos.
# Comma-separated. Paths with spaces are supported.
#
# Windows (Git Bash): use /e/ instead of E:\
# Mac/Linux: use normal paths
#
# Examples:
#   CUSTOM_PROJECT_DIRS="/e/Projects"
#   CUSTOM_PROJECT_DIRS="/e/Projects,/c/Users/you/.codex,/c/Users/you/.hermes"
#   CUSTOM_PROJECT_DIRS="$HOME/projects,/opt/repos"
#
# Safety:
#   - Fast-forward pulls only; dirty repos are skipped instead of pulled.
#   - Push URLs are left alone unless GITHUB_OWNERS is set (below or in
#     local/shared.env). When it is set, repos owned by those GitHub accounts
#     keep push access and every other repo found here is set to no_push.
#
# CUSTOM_PROJECT_DIRS=""

# =============================================================================
# Your GitHub account(s), comma-separated
# =============================================================================
# Unset: the session-end and daily sweep do nothing (no commit, no push) and no
# push URL is changed. Set: repos owned by these accounts are checkpointed and
# pushed at session end; see hooks/README.md and local.example/README.md.
#
# GITHUB_OWNERS="your-github-username"

# =============================================================================
# Background behavior switches (all optional; shown with their defaults)
# =============================================================================
# PULL_INTERVAL_HOURS=24        # 0 = never pull ~/.claude and marketplaces in the background
# PULL_CUSTOM_PROJECT_DIRS=1    # 0 = background pull skips CUSTOM_PROJECT_DIRS
# PLUGIN_AUTOINSTALL=1          # 0 = background pull never installs/updates plugins
# LSP_AUTOINSTALL=1             # 0 = never install language-server packages globally
# SESSION_END_AUTOPUSH=1        # 0 = commit checkpoints but never push
# DAILY_MAINTENANCE=1           # 0 = no daily usage tally / commit sweep

# =============================================================================
# Git identity overrides (if different per machine)
# =============================================================================
# GIT_USER_NAME="Your Name"
# GIT_USER_EMAIL="your@email.com"

# =============================================================================
# SSH key path (if non-default)
# =============================================================================
# SSH_KEY_PATH="~/.ssh/id_ed25519"
