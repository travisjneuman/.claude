# ============================================================
# Claude Code toolkit (~/.claude) — public repo .gitignore
# ============================================================
# ~/.claude is both this toolkit and Claude Code's own home folder, so most
# of what Claude Code writes here is runtime state, personal history, or
# machine-specific. Only the toolkit itself is tracked:
#
#   CLAUDE.md, README.md, CHANGELOG.md, CONTRIBUTING.md, LICENSE, INDEX.md
#   settings.json (toolkit defaults: permissions, hooks, plugins, budgets)
#   agents/ commands/ skills/ rules/ hooks/ templates/ docs/ scripts/ bin/
#   index/ website/ vscode/ archive/ local.example/ .github/
#   plugin.json package.json counts.json .gitmodules (marketplace manifest)
#
# Anything personal (private rules and hooks, host paths, identity, subagent
# memory, the public-safety pattern list) belongs in your private layer:
# ~/.claude/local/, ignored below. See local.example/README.md.
#
# SECURITY: entries here keep personal data out of a public repo. Don't
# remove one without checking what Claude Code writes to that path.
# New machine: docs/SETUP-GUIDE.md and scripts/setup-new-machine.sh.
# ============================================================

# ----- PRIVATE LAYER -----
/local
/rules/local
.env.local
.env
.env.*.local
settings.local.json
CLAUDE.local.md
# Subagent memory (`memory: user` agents write here). Personal and often
# project-specific; link it into your private layer instead of tracking it.
agent-memory

# ----- CREDENTIALS -----
.credentials.json
.credentials.lock
.oauth_refresh.lock*
credentials.json
security_warnings_state_*.json

# ----- CONVERSATIONS, SESSIONS, AND HISTORY -----
history.jsonl
projects/
sessions/
session-env/
session-summaries/
last-session.md
shell-snapshots/
file-history/
todos/
tasks/
teams/
plans/
debug/
ide/

# ----- CACHES, TELEMETRY, AND DOWNLOADS -----
cache/
paste-cache/
image-cache/
downloads/
statsig/
telemetry/
usage-data/
stats-cache.json
mcp-needs-auth-cache.json
*-cache.json
.last-cleanup
logs/
*.log

# ----- BACKUPS -----
backups/
.backups/
.archive/

# ----- PLUGINS AND MARKETPLACES (pulled per machine, never committed) -----
# .gitmodules is only the marketplace manifest read by
# scripts/init-marketplaces.sh; the clones themselves stay local.
/plugins/marketplaces/
/plugins/cache/
/plugins/data/
/plugins/synced/
/plugins/installed_plugins.json
/plugins/known_marketplaces.json
/plugins/blocklist.json
/plugins/.last_inuse_sweep
/skills/synced/
/index/marketplace-catalog.json
/security/

# ----- TOOL STATE IN THIS FOLDER -----
.claude.json
.mcp.json
AGENTS.md
.worktrees/
# A nested .claude/ keeps only the toolkit's own project settings.
/.claude/*
!/.claude/settings.json

# ----- EDITORS -----
.idea/
.vscode/
*.code-workspace
# vscode/ (no dot) holds tracked setup scripts; its settings.json is personal.
vscode/settings.json
*.swp
*.swo
*.swn
\#*\#
.#*

# ----- OPERATING SYSTEMS -----
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.Trash-*
.nfs*

# ----- DEPENDENCIES AND BUILD OUTPUT -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.yarn/unplugged
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/

# ----- DATABASES, ARCHIVES, TEMP -----
*.db
*.sqlite
*.sqlite3
*.zip
*.tar.gz
*.rar
*.7z
tmp/
temp/

# Working files from third-party agent tools run against this repo (never part of the toolkit)
.auto-claude/
/.planning/
.mc-context.md
